# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call this API (CORS).
# Hosted Lovable preview cannot reach your Mac localhost — CORS alone does not fix that.
# For local Lovable/Vite use localhost origins; add your preview URL when tunneling.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://id-preview--aec36bb1-da36-4b41-9f17-df680b48ef48.lovable.app

# CompreFace (run docker-compose.compreface.yml, then create a Face Detection service in the UI)
COMPREFACE_URL=http://localhost:8080
COMPREFACE_API_KEY=
# detection = Face Detection service key; recognition = Face Recognition service key (still detects boxes)
COMPREFACE_SERVICE_TYPE=detection
# Optional query params forwarded to CompreFace detect/recognize endpoints
COMPREFACE_DET_PROB_THRESHOLD=
COMPREFACE_FACE_LIMIT=0
COMPREFACE_MAX_DETECT_SIZE=640
COMPREFACE_TIMEOUT_SECONDS=60
# Minimum CompreFace similarity (0–1) to count as a match on POST /api/v1/faces/match
COMPREFACE_MATCH_SIMILARITY_THRESHOLD=0.75
# Return only the top N matches by similarity (1 = best match only; 0 = all above threshold)
COMPREFACE_MATCH_MAX_RESULTS=1

MAX_UPLOAD_BYTES=10485760
OUTPUT_DIR=outputs
HISTORY_FILE=data/history.json
